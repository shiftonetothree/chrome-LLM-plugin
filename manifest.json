{
  "manifest_version": 3,
  "name": "狐狸学伴AI助手",
  "version": "1.6.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "{766bb7e2-0e5a-4e2e-bc4a-bd2fe3d43214}",
      "data_collection_permissions": {
        "required": ["browsingActivity", "websiteContent"]
      }
    }
  },
  "description": "Chat with AI about the current webpage content - supports multiple LLM providers",
  "permissions": [
    "storage",
    "sidePanel",
    "contextMenus",
    "tabs"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
